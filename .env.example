SMTP_USERNAME=your_gmail@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM=your_gmail@gmail.com
EMAIL_TO=your_recipient@gmail.com

GROQ_API_KEY=your_primary_key
GROQ_API_KEY_2=your_second_key
GROQ_API_KEY_3=your_third_key
GROQ_API_KEY_4=your_fourth_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_RETRIES_PER_OP=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

AI_PROVIDER_PRIORITY=groq,gemini,mistral
AI_AUTO_FAILOVER=true
AI_MAX_RETRIES_PER_PROVIDER=2

NEWS_API_KEY=

DATABASE_PATH=data/digest.db

REQUEST_TIMEOUT=20
MAX_NEWS_ITEMS=120
MAX_JOB_ITEMS=100
MAX_DISPLAY_JOBS=30
MIN_CREDIBILITY_SCORE=55
TOP_STORIES_COUNT=5

WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_BASE_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
